{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // node18 keeps the CommonJS emit Electron needs (package.json has no
    // "type": "module") while using modern resolution. The previous
    // moduleResolution "node10" was deprecated in TS 6 and removed in TS 7.
    "module": "node18",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/**/__tests__/**"]
}

